  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Key"
      },
      "bootstrap": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Bootstrap-Key"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateProduct": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "CAMISA-BAHIA-M"
          },
          "stock": {
            "type": "number",
            "example": 10
          }
        },
        "required": [
          "sku",
          "stock"
        ]
      },
      "CreateHold": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "example": "CAMISA-BAHIA-M"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "ttlSeconds": {
            "type": "number",
            "example": 300,
            "maximum": 3600
          }
        },
        "required": [
          "sku",
          "quantity",
          "ttlSeconds"
        ]
      }
    }
  }
